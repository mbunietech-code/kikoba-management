APP_NAME="Benja Kikoba"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# ASSET_URL=https://your-domain      # set in production so /build URLs are https

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=benja_kikoba
DB_USERNAME=root
DB_PASSWORD=
DB_ENGINE=InnoDB

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@benjakikoba.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

# Flutter app / API token lifetimes
SANCTUM_STATEFUL_DOMAINS=localhost
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
OTP_TTL=300
OTP_LENGTH=6

# Beem Africa SMS — leave SMS_ENABLED=false to skip OTP (codes are logged in dev)
SMS_ENABLED=false
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=INFO
BEEM_SMS_URL=https://apisms.beem.africa/v1/send
