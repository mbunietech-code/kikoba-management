# Only relevant when a web server's document root points at the project
# root instead of /public (e.g. Hostinger and other shared hosts).
# On a proper setup (docroot = public/, or `php artisan serve`) this file is inert.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
